# Copie para .env e preencha (ou deixe o bootstrap.py perguntar interativamente
# e gravar este arquivo para você — ver README.md).
# --- Credenciais do Slack App (geradas em api.slack.com/apps após instalar o app) ---
SLACK_BOT_TOKEN=xoxb-substitua-pelo-token-do-seu-app
SLACK_SIGNING_SECRET=substitua-pelo-signing-secret-do-seu-app
# Token xapp-... com o scope connections:write (Basic Information > App-Level Tokens)
# — necessário só no modo Socket Mode (app.py), que é o padrão deste projeto.
SLACK_APP_TOKEN=xapp-substitua-pelo-app-level-token
# --- User Groups (Settings > People > User Groups no Slack; formato S0XXXXXXX) ---
SLACK_GROUP_ENGENHARIA=
SLACK_GROUP_CAMPO=
SLACK_GROUP_DIRETORIA=
SLACK_GROUP_FINANCEIRO=
# --- Integração ERP ---
ERP_WEBHOOK_URL=http://localhost:8080/erp/webhook
ERP_WEBHOOK_TIMEOUT_SECONDS=5
ERP_XML_DROP_FOLDER=./erp_inbox
# --- Servidor (só usado se você trocar para app_http.py em produção) ---
PORT=3000
SLACK_TOKEN_VERIFICATION_ENABLED=true
